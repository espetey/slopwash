# Hosted rewrite model key (set in the hosting dashboard, never committed).
ANTHROPIC_PROD=
# Optional override for the rewrite model.
ANTHROPIC_MODEL=

# Item 3a: Postgres for API keys, metering, and the flywheel.
# Vercel Postgres provisions POSTGRES_URL; DATABASE_URL wins when both exist.
DATABASE_URL=
POSTGRES_URL=

# Item 3a: secret for the admin routes (key issuance, org management, jobs).
ADMIN_SECRET=

# Item 3a: daily estimated Anthropic spend cap for keyed rewrites, USD.
# Defaults to 25 when unset.
DAILY_SPEND_CAP_USD=
